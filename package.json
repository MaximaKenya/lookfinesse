{
  "name": "marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "clean:dev-cache": "node scripts/clean-dev-cache.js",
    "dev": "next dev --webpack -H 0.0.0.0",
    "dev:clean": "node scripts/clean-dev-cache.js && next dev --webpack -H 0.0.0.0",
    "dev:turbo": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "seed": "node -e \"const fs=require('fs');const sql=fs.readFileSync('./supabase/seed.sql','utf8');console.log('Copy the SQL below into Supabase SQL Editor:\\n');console.log(sql)\""
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-table": "^8.21.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.1.6",
    "openai": "^6.38.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stripe": "^8.0.416",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
