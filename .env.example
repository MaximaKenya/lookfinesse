# Copy to `.env.local` and fill in real values. Restart `npm run dev` after changes.
# Full production checklist: docs/LIVE_INTEGRATIONS.md · Heroku: docs/HEROKU.md
# Never commit secrets. Do not invent fake API keys.

# ─── Supabase (P0 — auth, DB, Storage) ───────────────────────────────────────
# Dashboard → Project Settings → API
# URL format: https://<project-ref>.supabase.co  (no trailing slash)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only — webhooks, ensureVendorTrial RLS bypass, admin writes. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# If you see ENOTFOUND / "Failed to fetch" / "Cannot reach Supabase" banner:
# - The project ref in the URL must match a LIVE Supabase project (not paused/deleted)
# - Replace placeholder or dead URLs
# - Run: nslookup YOUR_PROJECT_REF.supabase.co  (should resolve)
#
# Storage (same keys): buckets `products`, `product-images`, `profile-media` (public).
# See docs/STORAGE_SETUP.md

# ─── App base URL (P0 — OAuth redirects, M-Pesa callbacks, Stripe return URLs) ─
# Local: http://localhost:3000
# Production / Heroku: https://your-app.herokuapp.com  (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Alias used on some Heroku setups — keep in sync with BASE_URL when set
NEXT_PUBLIC_APP_URL=

# ─── Google OAuth (P1 — configure in Supabase Dashboard, not app env) ────────
# Auth → Providers → Google: enable + client ID/secret in Supabase.
# Redirect allow-list: {BASE_URL}/auth/callback (and http://localhost:3000/auth/callback)

# ─── Hosting / Heroku (P0) ───────────────────────────────────────────────────
# NODE_ENV=production          # set automatically on Heroku
# PORT=                        # set by Heroku; do not hardcode in prod
# NODE_OPTIONS=--max-old-space-size=460   # optional if Next build OOMs
# heroku config:set … — see docs/HEROKU.md and docs/LIVE_INTEGRATIONS.md

# ─── M-Pesa / Daraja (P1) ────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# B2C / payouts
MPESA_INITIATOR=
MPESA_SECURITY_CREDENTIAL=
# Callbacks: {ORIGIN}/api/mpesa/* — docs/PAYMENTS_PRODUCTION.md

# ─── Stripe (P1) ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Connect
STRIPE_CONNECT_CLIENT_ID=
# Webhook: {ORIGIN}/api/stripe/webhook

# ─── OpenAI (P2 — stylist, beauty, fitness, copilot; degrades without) ───────
OPENAI_API_KEY=
# Optional model overrides (defaults: gpt-4o-mini fast, gpt-4o deep)
OPENAI_MODEL_FAST=
OPENAI_MODEL_DEEP=
# Groq is NOT used — do not set GROQ_API_KEY expecting AI chat to use it.
# See docs/AI_PROVIDERS.md

# ─── Resend (P2 — transactional / alert email) ───────────────────────────────
RESEND_API_KEY=

# ─── Google Maps (P2 — nearby / map widgets) ─────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Cron / scheduled jobs (P2) ──────────────────────────────────────────────
# Protect /api/cron/* with: Authorization: Bearer $CRON_SECRET
CRON_SECRET=
