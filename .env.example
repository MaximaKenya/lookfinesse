# Copy to `.env.local` and fill in real values. Restart `npm run dev` after changes.
# Production: docs/GO_LIVE_CHECKLIST.md (Vercel Hobby). Never commit secrets.
# `npm run build` must succeed with every value below unset.

# ─── Supabase (auth, DB, Storage) ────────────────────────────────────────────
# Dashboard → Project Settings → API
# URL format: https://<project-ref>.supabase.co  (no trailing slash)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only — webhooks, admin reads past RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Storage buckets (same keys): `products`, `product-images`, `profile-media` (public).
# Paste supabase/GO_LIVE.sql after 000_fresh_bootstrap.sql. See docs/STORAGE_SETUP.md.

# ─── App base URL (OAuth redirects, M-Pesa callbacks, Stripe return URLs) ────
# Local: http://localhost:3000
# Production: https://your-app.vercel.app  (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Optional alias. Used only when NEXT_PUBLIC_BASE_URL is unset.
NEXT_PUBLIC_APP_URL=

# ─── Google OAuth (configure in Supabase Dashboard, not as an app secret) ───
# 1. Google Cloud OAuth client redirect: https://<project-ref>.supabase.co/auth/v1/callback
# 2. Supabase → Authentication → Providers → Google: enable + client id/secret
# 3. Supabase → Authentication → URL Configuration
#    Site URL: {BASE_URL}
#    Redirect URLs: {BASE_URL}/auth/callback
#                   http://localhost:3000/auth/callback

# ─── M-Pesa / Daraja ─────────────────────────────────────────────────────────
# https://developer.safaricom.co.ke/ → your app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# B2C / payouts
MPESA_INITIATOR=
MPESA_SECURITY_CREDENTIAL=
# Set to 1 to show M-Pesa on /checkout
NEXT_PUBLIC_MPESA_ENABLED=
# Callbacks (HTTPS):
#   STK:              {BASE_URL}/api/mpesa/callback
#   B2C result:       {BASE_URL}/api/mpesa/payout-result
#   B2C timeout:      {BASE_URL}/api/mpesa/payout-timeout

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook endpoint {BASE_URL}/api/stripe/webhook → signing secret
STRIPE_WEBHOOK_SECRET=
# Optional Connect client id (ca_...). Onboarding uses STRIPE_SECRET_KEY.
STRIPE_CONNECT_CLIENT_ID=

# ─── OpenAI (stylist, beauty, fitness, copilot; demo copy when unset) ───────
OPENAI_API_KEY=
# Optional overrides (defaults: gpt-4o-mini fast, gpt-4o deep)
OPENAI_MODEL_FAST=
OPENAI_MODEL_DEEP=
# Groq is NOT used. See docs/AI_PROVIDERS.md

# ─── Resend (transactional / alert email; skipped when unset) ───────────────
RESEND_API_KEY=

# ─── Google Maps (nearby map preview; list + distances work without it) ─────
# Google Cloud Console → Maps JavaScript API → API key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Web Push (optional; local notifications work without it) ───────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Cron ────────────────────────────────────────────────────────────────────
# openssl rand -hex 32
# Vercel Cron sends: Authorization: Bearer $CRON_SECRET
# Protects /api/cron/* , GET /api/payments/reconcile , POST /api/subscriptions/reminders
# Hobby schedule in vercel.json: 0 3 * * *  →  /api/payments/reconcile
CRON_SECRET=
